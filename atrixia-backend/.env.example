# AI Provider options: google-studio, vertex, ollama, huggingface, openrouter
AI_PROVIDER=google-studio

# Google AI Studio API Key (Gemma 4 model integration)
GEMMA_API_KEY=

# Google Cloud / Vertex configuration
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=

# Ollama local host URL configuration
OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace Token key
HUGGINGFACE_API_KEY=

# OpenRouter Token key
OPENROUTER_API_KEY=

# PostgreSQL Database URL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/atrixia

# JWT Secret signing key
JWT_SECRET=

# Server configuration
PORT=5000

# -----------------------------------------------
# Marketplace API Keys (optional but recommended)
# -----------------------------------------------

# eBay Browse API — register free at https://developer.ebay.com
# Without these, eBay adapter falls back to HTML scraping (likely 403).
EBAY_APP_ID=
EBAY_CERT_ID=

# AliExpress Affiliate API — register at https://portals.aliexpress.com
# Without this, AliExpress returns 0 results (bot-challenge page).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# Generic scraper proxy (optional) — e.g. ScraperAPI key from https://www.scraperapi.com
# Used as fallback when direct scraping is blocked.
SCRAPER_API_KEY=
